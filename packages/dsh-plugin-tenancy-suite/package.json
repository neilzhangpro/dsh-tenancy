{
  "name": "dsh-plugin-tenancy-suite",
  "version": "0.3.0",
  "description": "Tenant-aware DSH UI and agent entrypoint",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": { ".": "./dist/index.js", "./client": "./dist/client.js" },
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "scripts": { "build": "esbuild src/index.ts src/client.ts src/suite.test.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --external:react --external:@deepseek-ai/*" },
  "dependencies": { "dsh-plugin-tenancy": "0.3.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2",
    "react": ">=18"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-slots"], "platform": "web" }
  }
}
